{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "modulePathIgnorePatterns": [
    "<rootDir>/../src/modules/ai",
    "<rootDir>/../src/modules/ai/",
    "<rootDir>/../src/**/ai/"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/ai/",
    "/transformers/"
  ],
  "setupFilesAfterEnv": ["<rootDir>/test/setup-e2e.ts"]
}