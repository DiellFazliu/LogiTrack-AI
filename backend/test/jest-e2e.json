{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(lodash-es|@xenova/transformers|onnxruntime-node)/)"
  ],
  "moduleNameMapper": {
    "^@xenova/transformers$": "<rootDir>/../node_modules/@xenova/transformers/dist/transformers.js"
  }
}